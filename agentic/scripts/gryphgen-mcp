#!/usr/bin/env python3
"""
GRYPHGEN MCP server — stdio entrypoint.

Register with Claude Code:
  claude mcp add gryphgen -- python3 /path/to/gryphgen-mcp \\
    --api-key gryphgen-test-tandem-2026 \\
    --url https://api.grug.ai

Or using the SSE endpoint (for persistent service):
  claude mcp add gryphgen-remote --transport sse \\
    --url https://api.grug.ai/mcp/sse \\
    --header "X-API-Key: gryphgen-test-tandem-2026"

Exposed MCP tools:
  generate_code(prompt, language?, tier?)  — code generation
  agent_run(task, max_steps?)             — agentic ReAct loop
  web_search(query, max_results?)         — DuckDuckGo search
"""

import argparse
import os
import sys

# Allow running from the repo without installing the package
_src = os.path.join(os.path.dirname(__file__), "..", "src")
if os.path.isdir(_src) and _src not in sys.path:
    sys.path.insert(0, os.path.abspath(_src))


def main() -> None:
    parser = argparse.ArgumentParser(
        description="GRYPHGEN MCP server (stdio transport)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--api-key",
        default=None,
        help="API key (default: $GRYPHGEN_API_KEY or ~/.config/gryphgen/config.toml)",
    )
    parser.add_argument(
        "--url",
        default=None,
        help="API base URL (default: https://api.grug.ai)",
    )
    args = parser.parse_args()

    try:
        from gryphgen_mcp.gryphgen_server import make_server
    except ImportError:
        # Fallback for running outside installed package (src on path)
        from src.gryphgen_mcp.gryphgen_server import make_server  # type: ignore[no-redef]

    server = make_server(api_key=args.api_key, base_url=args.url)
    server.run("stdio")  # blocks until stdin closes


if __name__ == "__main__":
    main()

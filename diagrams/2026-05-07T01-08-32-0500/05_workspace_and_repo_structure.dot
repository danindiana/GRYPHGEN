digraph workspace_repo_structure {
    graph [
        bgcolor="#0d0d0d"
        fontname="Courier New"
        fontcolor="#cc00ff"
        label="GRYPHGEN  Workspace + Repository Structure"
        labelloc=t
        fontsize=20
        pad=0.6
        splines=ortho
        rankdir=TB
    ]
    node [
        fontname="Courier New"
        fontsize=10
        style="filled,rounded"
        penwidth=2
    ]
    edge [
        fontname="Courier New"
        fontsize=9
        penwidth=1.5
    ]

    root [
        label="2026-05-06_gryphgen-modernization/"
        fillcolor="#1a001a"
        color="#cc00ff"
        fontcolor="#cc00ff"
        shape=folder
    ]

    session_docs [
        label="session.md\nsession_2026-05-06T23-52-34.md"
        fillcolor="#0d0d1a"
        color="#6688ff"
        fontcolor="#6688ff"
        shape=note
    ]

    diagrams_parent [
        label="diagrams/\n2026-05-07T01-08-32-0500/"
        fillcolor="#0d001a"
        color="#aa00ff"
        fontcolor="#aa00ff"
        shape=folder
    ]

    gryphgen_repo [
        label="GRYPHGEN/\n[git repo]\ndanindiana/GRYPHGEN"
        fillcolor="#001a1a"
        color="#00ffff"
        fontcolor="#00ffff"
        shape=folder
    ]

    subgraph cluster_repo_contents {
        label="GRYPHGEN/ (repo contents)"
        fontcolor="#00ffff"
        color="#00ffff"
        bgcolor="#001111"
        style=rounded
        penwidth=2

        cargo_workspace [
            label="Cargo.toml\n[workspace]\nmembers: wizard · ollama-duel"
            fillcolor="#1a1a00"
            color="#ffff00"
            fontcolor="#ffff00"
            shape=note
        ]

        subgraph cluster_wizard {
            label="wizard/  (gryphgen-wizard)"
            fontcolor="#ff00ff"
            color="#ff00ff"
            bgcolor="#1a001a"
            style=rounded
            penwidth=1

            wizard_src [
                label="src/\nmain.rs · app.rs · ui.rs\napi.rs · config.rs · events.rs"
                fillcolor="#1a001a"
                color="#ff00ff"
                fontcolor="#ff00ff"
                shape=note
            ]
            wizard_bin [
                label="target/release/gg-wizard\n→ GRYPHGEN/target/release/\n(workspace symlink)"
                fillcolor="#0d0d1a"
                color="#8800ff"
                fontcolor="#8800ff"
                shape=note
            ]
        }

        subgraph cluster_duel {
            label="ollama-duel/"
            fontcolor="#ff6600"
            color="#ff6600"
            bgcolor="#1a0a00"
            style=rounded
            penwidth=1

            duel_src [
                label="src/\nmain.rs · app.rs · ui.rs\nactor_critic.rs · ollama.rs\nconfig.rs · mcp/"
                fillcolor="#1a0a00"
                color="#ff6600"
                fontcolor="#ff6600"
                shape=note
            ]
            duel_config [
                label="config.toml\nactor · critic · orchestration\nollama · mcp_servers"
                fillcolor="#1a0800"
                color="#ff8800"
                fontcolor="#ff8800"
                shape=note
            ]
        }

        subgraph cluster_agentic_copy {
            label="agentic/  (source copy)"
            fontcolor="#00ff88"
            color="#00ff88"
            bgcolor="#001a0d"
            style=rounded
            penwidth=1

            agentic_src [
                label="src/\napi/ · agent/ · services/\nllm/ · auth/ · tools/"
                fillcolor="#001a0d"
                color="#00ff88"
                fontcolor="#00ff88"
                shape=note
            ]
        }

        diagrams_repo [
            label="diagrams/\n2026-05-07T01-04-49-0500/\n5× .dot + .png + .svg"
            fillcolor="#0d001a"
            color="#aa00ff"
            fontcolor="#aa00ff"
            shape=folder
        ]
    }

    programs_agentic [
        label="/programs/gryphgen-agentic/\n[running service — no git]\nuvicorn  :8090"
        fillcolor="#001a0d"
        color="#00ffff"
        fontcolor="#00ffff"
        shape=folder
    ]

    github [
        label="github.com/danindiana/GRYPHGEN\nmain branch\n8 commits ahead"
        fillcolor="#0d0d1a"
        color="#6688ff"
        fontcolor="#6688ff"
        shape=cylinder
    ]

    root -> session_docs [color="#6688ff" fontcolor="#6688ff" style=dashed]
    root -> diagrams_parent [color="#aa00ff" fontcolor="#aa00ff"]
    root -> gryphgen_repo [color="#00ffff" fontcolor="#00ffff"]
    gryphgen_repo -> cargo_workspace [color="#ffff00" fontcolor="#ffff00"]
    gryphgen_repo -> wizard_src [color="#ff00ff" fontcolor="#ff00ff"]
    gryphgen_repo -> wizard_bin [color="#8800ff" fontcolor="#8800ff" style=dashed]
    gryphgen_repo -> duel_src [color="#ff6600" fontcolor="#ff6600"]
    gryphgen_repo -> duel_config [color="#ff8800" fontcolor="#ff8800"]
    gryphgen_repo -> agentic_src [color="#00ff88" fontcolor="#00ff88"]
    gryphgen_repo -> diagrams_repo [color="#aa00ff" fontcolor="#aa00ff"]
    agentic_src -> programs_agentic [label="deployed copy\n(manual sync)" color="#00ffff" fontcolor="#00ffff" style=dashed]
    gryphgen_repo -> github [label="git push\norigin main" color="#6688ff" fontcolor="#6688ff"]
}

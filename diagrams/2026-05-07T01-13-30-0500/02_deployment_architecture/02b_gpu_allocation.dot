digraph gpu_allocation {
    graph [bgcolor="#0d0d0d" fontname="Courier New" fontcolor="#ff6600"
           label="GPU Resource Allocation  —  worlock" labelloc=t fontsize=18 pad=0.5 rankdir=TB]
    node [fontname="Courier New" fontsize=10 style="filled,rounded" penwidth=2]
    edge [fontname="Courier New" fontsize=9 penwidth=1.5]

    ollama_svc [label="ollama.service\nCUDA_VISIBLE_DEVICES=0,1\nOLLAMA_MAX_LOADED_MODELS=1\nOLLAMA_NUM_PARALLEL=1\nOLLAMA_KEEP_ALIVE=5m" fillcolor="#1a1a00" color="#ffff00" fontcolor="#ffff00"]

    subgraph cluster_gpu0 {
        label="GPU 0  —  RTX 5080" fontcolor="#ff6600" color="#ff6600" bgcolor="#1a0800" style=rounded penwidth=2
        gpu0_spec [label="16 GB GDDR7\nAda Lovelace\nPCIe x16" fillcolor="#1a0800" color="#ff6600" fontcolor="#ff6600" shape=note]
        thinker_m [label="deepseek-r1:14b\nTHINKER_MODEL\n:11434\n~10 GB VRAM" fillcolor="#1a1200" color="#ffff00" fontcolor="#ffff00"]
        devstral_m [label="devstral:24b\nOLLAMA_MODEL\n:11434\nAGENT tasks\n~15 GB VRAM" fillcolor="#1a1500" color="#ffe000" fontcolor="#ffe000"]
        qwen3b_m [label="qwen2.5:3b\nollama-duel actor/critic\n~2 GB VRAM" fillcolor="#1a0800" color="#ff8800" fontcolor="#ff8800"]
    }

    subgraph cluster_gpu1 {
        label="GPU 1  —  RTX 3080" fontcolor="#ff4400" color="#ff4400" bgcolor="#1a0500" style=rounded penwidth=2
        gpu1_spec [label="10 GB GDDR6X\nAmpere\nPCIe x8" fillcolor="#1a0500" color="#ff4400" fontcolor="#ff4400" shape=note]
        coder_m [label="qwen2.5-coder:7b\nCODER_MODEL\n:11436\n~5 GB VRAM" fillcolor="#1a0d00" color="#ff9900" fontcolor="#ff9900"]
    }

    keep_alive [label="KEEP_ALIVE=5m\nmodel evicted from\nVRAM after 5m idle\nmax 1 loaded" fillcolor="#0d0d1a" color="#6688ff" fontcolor="#6688ff" shape=note]

    queue [label="OLLAMA_NUM_PARALLEL=1\nrequests queue\nno concurrent inference" fillcolor="#1a0000" color="#ff0044" fontcolor="#ff0044" shape=note]

    ollama_svc -> gpu0_spec [color="#ff6600" fontcolor="#ff6600"]
    ollama_svc -> gpu1_spec [color="#ff4400" fontcolor="#ff4400"]
    gpu0_spec -> thinker_m [label="STANDARD/STRONG" color="#ffff00" fontcolor="#ffff00"]
    gpu0_spec -> devstral_m [label="AGENT" color="#ffe000" fontcolor="#ffe000"]
    gpu0_spec -> qwen3b_m [label="ollama-duel" color="#ff8800" fontcolor="#ff8800"]
    gpu1_spec -> coder_m [label="FAST/code gen" color="#ff9900" fontcolor="#ff9900"]
    ollama_svc -> keep_alive [color="#6688ff" fontcolor="#6688ff" style=dashed]
    ollama_svc -> queue [color="#ff0044" fontcolor="#ff0044" style=dashed]
}

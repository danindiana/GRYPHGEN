digraph full_request_flow {
    graph [bgcolor="#0d0d0d" fontname="Courier New" fontcolor="#00ffff"
           label="Full Request Flow  —  gg-wizard → Code Response" labelloc=t fontsize=18 pad=0.5 rankdir=LR]
    node [fontname="Courier New" fontsize=10 style="filled,rounded" penwidth=2]
    edge [fontname="Courier New" fontsize=9 penwidth=1.5]

    user [label="User\nEnter prompt\nin gg-wizard" fillcolor="#001a1a" color="#00ffff" fontcolor="#00ffff" shape=parallelogram]
    wizard_thread [label="std::thread\nureq::post()\nblocking HTTP\ntimeout=600s" fillcolor="#1a001a" color="#ff00ff" fontcolor="#ff00ff"]
    loopback [label="127.0.0.1:8090\nloopback" fillcolor="#111111" color="#444444" fontcolor="#888888"]
    fastapi_recv [label="FastAPI\nlog_requests\nmiddleware" fillcolor="#1a001a" color="#ff00ff" fontcolor="#ff00ff"]
    auth_check [label="require_api_key\nSHA-256 check\n~0ms" fillcolor="#1a0800" color="#ff6600" fontcolor="#ff6600" shape=hexagon]
    rate_check [label="rate limiter\nsliding window\n~0ms" fillcolor="#1a0500" color="#ff4400" fontcolor="#ff4400" shape=hexagon]
    tier_route [label="reasoning_effort\nroute to tier\nFAST/STD/STRONG" fillcolor="#1a1a00" color="#ffff00" fontcolor="#ffff00" shape=diamond]
    tandem [label="TandemPipeline\nTHINKER prompt\nconstruction" fillcolor="#1a1200" color="#ffcc00" fontcolor="#ffcc00"]
    ollama_thinker_req [label="POST /api/generate\ndeepseek-r1:14b\n:11434" fillcolor="#1a1500" color="#ffff00" fontcolor="#ffff00"]
    ollama_coder_req [label="POST /api/generate\nqwen2.5-coder:7b\n:11436" fillcolor="#1a0d00" color="#ff9900" fontcolor="#ff9900"]
    response_build [label="CodeGenerationResponse\ncode · tier · model\ntokens · time" fillcolor="#001a0d" color="#00ff41" fontcolor="#00ff41" shape=note]
    wizard_rx [label="rx.try_recv()\nApiResult::Gen\nDemoResult screen" fillcolor="#001a1a" color="#00ffff" fontcolor="#00ffff"]

    user -> wizard_thread [label="prompt string" color="#ff00ff" fontcolor="#ff00ff"]
    wizard_thread -> loopback [label="POST /api/v1/\ncode/generate" color="#ff00ff" fontcolor="#ff00ff"]
    loopback -> fastapi_recv [color="#ff00ff" fontcolor="#ff00ff"]
    fastapi_recv -> auth_check [color="#ff6600" fontcolor="#ff6600"]
    auth_check -> rate_check [label="pass" color="#ff4400" fontcolor="#ff4400"]
    rate_check -> tier_route [label="pass" color="#ffff00" fontcolor="#ffff00"]
    tier_route -> ollama_coder_req [label="FAST" color="#ff9900" fontcolor="#ff9900"]
    tier_route -> tandem [label="STD/STRONG" color="#ffcc00" fontcolor="#ffcc00"]
    tandem -> ollama_thinker_req [label="plan" color="#ffff00" fontcolor="#ffff00"]
    ollama_thinker_req -> ollama_coder_req [label="brief" color="#ff9900" fontcolor="#ff9900"]
    ollama_coder_req -> response_build [color="#00ff41" fontcolor="#00ff41"]
    response_build -> wizard_thread [label="JSON body" color="#ff00ff" fontcolor="#ff00ff"]
    wizard_thread -> wizard_rx [label="tx.send()" color="#00ffff" fontcolor="#00ffff"]
    wizard_rx -> user [label="result screen" color="#00ffff" fontcolor="#00ffff"]
}

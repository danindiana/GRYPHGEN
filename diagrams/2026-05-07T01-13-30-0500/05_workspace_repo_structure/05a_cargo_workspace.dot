digraph cargo_workspace {
    graph [bgcolor="#0d0d0d" fontname="Courier New" fontcolor="#00ff41"
           label="Cargo Workspace  —  GRYPHGEN/Cargo.toml" labelloc=t fontsize=18 pad=0.5 rankdir=TB]
    node [fontname="Courier New" fontsize=10 style="filled,rounded" penwidth=2]
    edge [fontname="Courier New" fontsize=9 penwidth=1.5]

    workspace_toml [label="GRYPHGEN/Cargo.toml\n[workspace]\nmembers = [\n  \"wizard\",\n  \"ollama-duel\",\n]\nresolver = \"2\"" fillcolor="#001a0d" color="#00ff41" fontcolor="#00ff41" shape=note]

    subgraph cluster_members {
        label="Workspace Members" fontcolor="#00ffff" color="#00ffff" bgcolor="#001a1a" style=rounded penwidth=2
        wizard [label="wizard/\nCargo.toml\nname = gryphgen-wizard\nbinary: gg-wizard" fillcolor="#001a1a" color="#00ffff" fontcolor="#00ffff"]
        duel [label="ollama-duel/\nCargo.toml\nname = ollama-duel\nbinary: ollama-duel" fillcolor="#001a1a" color="#00ccff" fontcolor="#00ccff"]
    }

    subgraph cluster_target {
        label="Shared target/" fontcolor="#ff9900" color="#ff9900" bgcolor="#1a0d00" style=rounded penwidth=2
        target_dir [label="GRYPHGEN/target/\n(single shared build cache)" fillcolor="#1a0d00" color="#ff9900" fontcolor="#ff9900" shape=folder]
        release_wiz [label="target/release/gg-wizard" fillcolor="#1a0800" color="#ff8800" fontcolor="#ff8800"]
        release_duel [label="target/release/ollama-duel" fillcolor="#1a0800" color="#ff7700" fontcolor="#ff7700"]
        lock [label="Cargo.lock\n(workspace-wide\ndependency lock)" fillcolor="#1a0500" color="#ff6600" fontcolor="#ff6600" shape=note]
    }

    subgraph cluster_commands {
        label="Useful Commands" fontcolor="#cc00ff" color="#cc00ff" bgcolor="#0d001a" style=rounded penwidth=2
        cmd1 [label="cargo build --workspace" fillcolor="#0d001a" color="#cc00ff" fontcolor="#cc00ff" shape=note]
        cmd2 [label="cargo run -p gryphgen-wizard" fillcolor="#0d001a" color="#aa00ff" fontcolor="#aa00ff" shape=note]
        cmd3 [label="cargo run -p ollama-duel" fillcolor="#0d001a" color="#9900ff" fontcolor="#9900ff" shape=note]
    }

    symlink [label="wizard/target/release/gg-wizard\n→ symlink →\nGRYPHGEN/target/release/gg-wizard" fillcolor="#1a1500" color="#ffff00" fontcolor="#ffff00" shape=note]

    workspace_toml -> wizard [color="#00ffff" fontcolor="#00ffff"]
    workspace_toml -> duel [color="#00ccff" fontcolor="#00ccff"]
    wizard -> target_dir [color="#ff9900" fontcolor="#ff9900"]
    duel -> target_dir [color="#ff9900" fontcolor="#ff9900"]
    target_dir -> release_wiz [color="#ff8800" fontcolor="#ff8800"]
    target_dir -> release_duel [color="#ff7700" fontcolor="#ff7700"]
    target_dir -> lock [color="#ff6600" fontcolor="#ff6600"]
    release_wiz -> symlink [color="#ffff00" fontcolor="#ffff00" style=dashed]
    workspace_toml -> cmd1 [color="#cc00ff" fontcolor="#cc00ff" style=dashed]
    cmd1 -> cmd2 [color="#aa00ff" fontcolor="#aa00ff" style=invis]
    cmd2 -> cmd3 [color="#9900ff" fontcolor="#9900ff" style=invis]
}

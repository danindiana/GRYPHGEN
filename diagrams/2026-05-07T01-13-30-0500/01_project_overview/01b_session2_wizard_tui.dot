digraph session2_wizard_tui {
    graph [bgcolor="#0d0d0d" fontname="Courier New" fontcolor="#ff00ff"
           label="Session 2 — gg-wizard  Screen State Machine" labelloc=t fontsize=18 pad=0.5 rankdir=LR]
    node [fontname="Courier New" fontsize=10 style="filled,rounded" penwidth=2]
    edge [fontname="Courier New" fontsize=9 penwidth=1.5]

    Welcome [label="Welcome\nENTER to start" fillcolor="#001a1a" color="#00ffff" fontcolor="#00ffff" shape=parallelogram]
    SetApiKey [label="SetApiKey\ntext input" fillcolor="#1a001a" color="#ff00ff" fontcolor="#ff00ff"]
    SetApiUrl [label="SetApiUrl\ntext input" fillcolor="#1a001a" color="#ff00ff" fontcolor="#ff00ff"]
    HealthCheck [label="HealthCheck\nspinner + GET /health" fillcolor="#1a1a00" color="#ffff00" fontcolor="#ffff00"]
    MainMenu [label="MainMenu\n7 items  ↑↓ navigate" fillcolor="#001a1a" color="#00ffff" fontcolor="#00ffff"]
    DemoExplain [label="DemoExplain\ntier description" fillcolor="#0d001a" color="#cc00ff" fontcolor="#cc00ff"]
    DemoPrompt [label="DemoPrompt\nedit prompt field" fillcolor="#0d001a" color="#cc00ff" fontcolor="#cc00ff"]
    DemoLoading [label="DemoLoading\nspinner  background thread" fillcolor="#1a1000" color="#ff8800" fontcolor="#ff8800"]
    DemoResult [label="DemoResult\nmeta bar + scrollable output" fillcolor="#001a0d" color="#00ff41" fontcolor="#00ff41"]
    ShowConfig [label="ShowConfig\nkey (redacted) + url" fillcolor="#001a1a" color="#00ccff" fontcolor="#00ccff"]
    ErrorOverlay [label="ErrorOverlay\nred popup + dismiss" fillcolor="#1a0000" color="#ff0044" fontcolor="#ff0044"]

    thread_fast [label="std::thread\napi::generate()\nreasoningeffort=none" fillcolor="#1a0d00" color="#ff9900" fontcolor="#ff9900" shape=note]
    thread_agent [label="std::thread\napi::agent_run()\ntimeout=600s" fillcolor="#1a0500" color="#ff4400" fontcolor="#ff4400" shape=note]
    thread_search [label="std::thread\napi::search()\nDDG" fillcolor="#0d001a" color="#9900ff" fontcolor="#9900ff" shape=note]

    Welcome -> SetApiKey [label="not configured" color="#ff00ff" fontcolor="#ff00ff"]
    Welcome -> HealthCheck [label="configured" color="#00ffff" fontcolor="#00ffff"]
    SetApiKey -> SetApiUrl [label="ENTER" color="#ff00ff" fontcolor="#ff00ff"]
    SetApiUrl -> HealthCheck [label="ENTER" color="#00ffff" fontcolor="#00ffff"]
    HealthCheck -> MainMenu [label="ok / fail" color="#00ff41" fontcolor="#00ff41"]
    MainMenu -> DemoExplain [label="1-5 ENTER" color="#cc00ff" fontcolor="#cc00ff"]
    MainMenu -> ShowConfig [label="6 ENTER" color="#00ccff" fontcolor="#00ccff"]
    DemoExplain -> DemoPrompt [label="ENTER" color="#cc00ff" fontcolor="#cc00ff"]
    DemoPrompt -> DemoLoading [label="ENTER" color="#ff8800" fontcolor="#ff8800"]
    DemoLoading -> thread_fast [color="#ff9900" fontcolor="#ff9900" style=dashed]
    DemoLoading -> thread_agent [color="#ff4400" fontcolor="#ff4400" style=dashed]
    DemoLoading -> thread_search [color="#9900ff" fontcolor="#9900ff" style=dashed]
    DemoLoading -> DemoResult [label="rx.try_recv()" color="#00ff41" fontcolor="#00ff41"]
    DemoLoading -> ErrorOverlay [label="API error" color="#ff0044" fontcolor="#ff0044"]
    DemoResult -> MainMenu [label="ENTER/ESC" color="#00ffff" fontcolor="#00ffff"]
    ShowConfig -> MainMenu [label="ENTER/ESC" color="#00ffff" fontcolor="#00ffff"]
    ErrorOverlay -> MainMenu [label="ESC" color="#ff0044" fontcolor="#ff0044"]
}

digraph agent_tool_dispatch {
    graph [bgcolor="#0d0d0d" fontname="Courier New" fontcolor="#cc00ff"
           label="AGENT Tier  —  Tool Dispatch + Sandbox Detail" labelloc=t fontsize=18 pad=0.5 rankdir=TB]
    node [fontname="Courier New" fontsize=10 style="filled,rounded" penwidth=2]
    edge [fontname="Courier New" fontsize=9 penwidth=1.5]

    tool_call [label="tool_calls in\nOllama response\n{name, arguments}" fillcolor="#1a001a" color="#ff00ff" fontcolor="#ff00ff" shape=parallelogram]
    hardening [label="Argument Hardening\nfn.get(\"arguments\") or {}\nhandle None + JSON str" fillcolor="#1a0000" color="#ff0044" fontcolor="#ff0044" shape=note]
    dispatch [label="dispatch(name, args, workspace)" fillcolor="#0d001a" color="#cc00ff" fontcolor="#cc00ff" shape=hexagon]

    subgraph cluster_tools {
        label="Tool Implementations  (agent/tools.py)" fontcolor="#00ff41" color="#00ff41" bgcolor="#001a0d" style=rounded penwidth=2
        list_dir [label="list_dir\n_safe_path()\nsorted entries\nkind · size · name" fillcolor="#001a0d" color="#00ff41" fontcolor="#00ff41"]
        read_file [label="read_file\n_safe_path()\np.read_text()\nerrors=replace" fillcolor="#001a0d" color="#00cc33" fontcolor="#00cc33"]
        write_file [label="write_file\n_safe_path()\np.parent.mkdir()\np.write_text()" fillcolor="#001a0d" color="#00ff41" fontcolor="#00ff41"]
        web_search [label="web_search\nDuckDuckGo\nmax_results=5\ntitle+url+snippet" fillcolor="#001a0d" color="#009922" fontcolor="#009922"]
    }

    subgraph cluster_sandbox {
        label="run_shell  →  DockerSandbox" fontcolor="#ff6600" color="#ff6600" bgcolor="#1a0a00" style=rounded penwidth=2
        docker_check [label="DockerSandbox\n.is_available()?\ndocker.from_env().ping()" fillcolor="#1a0a00" color="#ff6600" fontcolor="#ff6600" shape=diamond]
        docker_run [label="containers.run()\npython:3.12-slim\nmem_limit=256m\ncpu_quota=50000\nnetwork_disabled=True\nremove=True" fillcolor="#1a0800" color="#ff4400" fontcolor="#ff4400"]
        whitelist_fb [label="Whitelist fallback\npython3 · pip · pytest\ncargo · node · npm\nls · find · grep · git" fillcolor="#1a0500" color="#ff3300" fontcolor="#ff3300"]
    }

    path_guard [label="_safe_path()\n(workspace/rel).resolve()\nmust start with\nworkspace.resolve()" fillcolor="#1a0000" color="#ff0044" fontcolor="#ff0044" shape=note]

    tool_call -> hardening [color="#ff0044" fontcolor="#ff0044"]
    hardening -> dispatch [color="#cc00ff" fontcolor="#cc00ff"]
    dispatch -> list_dir [color="#00ff41" fontcolor="#00ff41"]
    dispatch -> read_file [color="#00cc33" fontcolor="#00cc33"]
    dispatch -> write_file [color="#00ff41" fontcolor="#00ff41"]
    dispatch -> web_search [color="#009922" fontcolor="#009922"]
    dispatch -> docker_check [color="#ff6600" fontcolor="#ff6600"]
    docker_check -> docker_run [label="yes" color="#ff4400" fontcolor="#ff4400"]
    docker_check -> whitelist_fb [label="no (fallback)" color="#ff3300" fontcolor="#ff3300"]
    list_dir -> path_guard [color="#ff0044" fontcolor="#ff0044" style=dashed]
    read_file -> path_guard [color="#ff0044" fontcolor="#ff0044" style=dashed]
    write_file -> path_guard [color="#ff0044" fontcolor="#ff0044" style=dashed]
}
